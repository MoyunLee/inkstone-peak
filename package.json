{
  "name": "inkstone-peak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "npm run media && vite",
    "preview": "vite preview --host 127.0.0.1",
    "build": "npm run content && npm run media && npm run assets && npm run gate && tsc --noEmit && vite build && npm run ssr && npm run prerender && npm run feeds",
    "build:quiet": "node scripts/build-quiet.ts",
    "clean": "node scripts/clean.ts",
    "clean:all": "node scripts/clean.ts --all",
    "ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir",
    "content": "node scripts/content/index.ts",
    "content:watch": "node scripts/content/index.ts --watch",
    "prerender": "node scripts/pre-render.ts",
    "feeds": "node scripts/feeds.ts",
    "media": "node scripts/media.ts",
    "assets": "node scripts/assets.ts",
    "gate": "node scripts/gate-cn.ts && node scripts/gate-debug.ts",
    "checklist": "node scripts/checklist.ts",
    "glyphs": "node scripts/glyphs.ts"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "zod": "^4.0.0"
  }
}
