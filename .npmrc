# 纪律 10 §1①：Windows 沙箱禁写用户目录 → cache 钉死在工程内（实测教训）
cache=.npm-cache
fund=false
audit=false
update-notifier=false
# npm 12 每调一次脚本就打一行 `npm notice run …`——本工程 build 链嵌了 7 个 npm run，
# 一趟构建就是 16 行记账号，还把真正的构建输出切得七零八落。压到 warn 只去掉 notice 级：
# 脚本自己的 stdout/stderr 照常透传，npm 的 warn 与 error（如 Missing script）仍然会吼。
loglevel=warn
